# ---------------------------------------------------------------------------
# Personal data — never commit
# ---------------------------------------------------------------------------

# Secrets and local configuration (keep only the template)
.env
.env.*
!.env.example
*.env.local

# Uploaded CVs, documents and attachments (backend/storage/)
storage/
# …but not the storage *code* package (it was hidden by the line above)
!backend/app/storage/
uploads/

# Local database (dev PostgreSQL data dir) and any database files/dumps
.devdb/
pgdata/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.sql.gz

# CV and document files anywhere in the tree (tests build their own in memory)
*.pdf
*.docx
*.doc

# Automatic backups (backend/backups/: database dump + data + CVs)
backups/

# Data exports and imports (downloads from the app, sheet/CSV/JSON dumps)
career-data.json
exports/
imports/
sheet_import/
data/
*.csv
!backend/tests/**/*.csv

# Runtime state and logs (start.sh / stop.sh)
.run/
logs/
*.log

# ---------------------------------------------------------------------------
# Build / tooling output
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
test-results/
playwright-report/
*.tsbuildinfo
.vite/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Google service-account keys (private credentials)
secrets/
backend/secrets/
*service-account*.json
google-credentials*.json

# Career-Ops (separate project, cloned by scripts/setup-career-ops.sh; holds personal data)
/career-ops/

# Graphify knowledge graph (generated)
/graphify-out/
scratch/
