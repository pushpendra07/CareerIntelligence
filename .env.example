# Career Intelligence — copy to backend/.env (native run) or ./.env (Docker) and edit.
# Never commit the real .env.

# PostgreSQL. Native dev: run `uv run python scripts/devdb.py` in backend/ and paste its output.
DATABASE_URL=postgresql+psycopg://career:career@localhost:5432/career_intelligence
# Docker only (./install.sh sets a random one): the database password, and where the app listens.
POSTGRES_PASSWORD=change-me
APP_PORT=8010
# 127.0.0.1 = this computer only; 0.0.0.0 = your network too (then also set APP_PASSWORD).
APP_BIND=127.0.0.1

# Optional; not used yet.
REDIS_URL=

# Career-Ops (read-only). Path to your Career-Ops checkout; data root defaults to the same path.
# Leave empty to use career-ops/ inside this project (./scripts/setup-career-ops.sh),
# or set the absolute path of another Career-Ops checkout.
CAREER_OPS_PATH=
CAREER_OPS_DATA_PATH=
# Career-Ops has no stable API; these stay empty unless one appears.
CAREER_OPS_URL=
CAREER_OPS_API_KEY=
# Allow triggering `node scan.mjs --json` from the app (off by default).
CAREER_OPS_SCAN_ENABLED=false

# AI is optional: none | openai | anthropic | gemini | ollama
AI_PROVIDER=none
AI_API_KEY=

STORAGE_PATH=storage
# Automatic backups (zip: database dump + data.json + CVs). Schedule: Settings → Backup & import.
BACKUP_PATH=backups
# Optional: require a password to open the app (empty = no login). Changing it logs everyone out.
APP_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Serve the built UI (frontend/dist) from the API on one port. Docker sets this itself.
STATIC_DIR=

LOG_LEVEL=INFO
LOG_FORMAT=json
